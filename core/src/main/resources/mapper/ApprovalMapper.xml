<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lumora.core.mapper.ApprovalMapper">

    <resultMap
            id="approvalResultMap"
            type="com.lumora.core.entity.ApprovalRecord">
        <id property="approvalId" column="approval_id"/>
        <result property="taskId" column="task_id"/>
        <result property="action" column="action"/>
        <result property="impactSummary" column="impact_summary"/>
        <result property="riskLevel" column="risk_level"/>
        <result property="reversible" column="reversible"/>
        <result property="decision" column="decision"/>
        <result property="createdAt" column="created_at"/>
        <result property="decidedAt" column="decided_at"/>
    </resultMap>

    <select id="findPendingByTaskId" resultMap="approvalResultMap">
        SELECT
            approval_id,
            task_id,
            action,
            impact_summary,
            risk_level,
            reversible,
            decision,
            created_at,
            decided_at
        FROM approval_request
        WHERE task_id = #{taskId}
          AND decision IS NULL
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <update id="updateDecision">
        UPDATE approval_request
        SET
            decision = #{decision},
            decided_at = #{decidedAt}
        WHERE approval_id = #{approvalId}
          AND decision IS NULL
    </update>
</mapper>
